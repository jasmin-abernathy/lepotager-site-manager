{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.lepotager.org/schemas/site-manager/v1/site-manifest.schema.json",
  "title": "Le Potager Site Manager discovery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "display_name", "api_base_url", "auth_methods"],
  "properties": {
    "schema_version": {"const": 1},
    "site_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "api_base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "auth_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["password_totp", "pairing_code"]}
    },
    "branding_preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "logo_url": {"type": "string", "format": "uri"}
      }
    },
    "support_url": {"type": "string", "format": "uri"},
    "protocol_min": {"type": "integer", "minimum": 1, "default": 1},
    "protocol_max": {"type": "integer", "minimum": 1, "default": 1}
  }
}
